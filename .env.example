# Copy to .env.production (or set these in your hosting dashboard) before building.

# Your Convex deployment URL, from `npx convex deploy` / the Convex dashboard. Without it the site
# builds in "demo" mode: data stays in each visitor's browser and the admin panel is disabled.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# The public address of the website (no trailing slash). Used for the canonical link, social previews,
# robots.txt and sitemap.xml.
VITE_SITE_URL=https://jagadamba-plastics-public-web-demo.vercel.app

# NOTE: the admin passcode is NOT set here. It is a server-side secret: set it in Convex with
#   npx convex env set ADMIN_PASSCODE "a long, private passphrase"
