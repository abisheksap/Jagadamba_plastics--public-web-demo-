{
  "name": "jagadamba-plastic-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
